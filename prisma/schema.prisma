generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  PHARMACIST
  CASHIER
  WAREHOUSE_MANAGER
  HR
  ACCOUNTANT
  MANAGER
}

enum StockMethod {
  FEFO
  FIFO
}

enum MovementType {
  IN
  OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum InventoryCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PREPARING
  DELIVERING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CLICK
  PAYME
  UZCARD
  HUMO
  VISA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum NotificationType {
  EXPIRY_WARNING
  BACK_IN_STOCK
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum InvoiceType {
  SALES
  PURCHASE
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum PayslipStatus {
  DRAFT
  PAID
}

enum StaffNotificationType {
  NEW_ORDER
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
}

// ---------- Core / Org ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements  StockMovement[]
  stockTransfers  StockTransfer[]
  inventoryCounts InventoryCount[]
  auditLogs       AuditLog[]
  managedBranches Branch[]           @relation("BranchManager")
  purchaseOrders  PurchaseOrder[]
  transactions    Transaction[]
  invoices        Invoice[]
  customerNotes   CustomerNote[]
  staffNotifications StaffNotification[]
  posSales        PosSale[]
}

model Customer {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  phone             String   @unique
  address           String?
  passwordHash      String
  isActive          Boolean  @default(true)
  telegramChatId    String?  @unique
  telegramLinkToken String?  @unique
  resetCodeHash      String?
  resetCodeExpiresAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  notifications Notification[]
  stockAlerts   StockAlertSubscription[]
  notes         CustomerNote[]
  appointments  Appointment[]
  reviews       Review[]
  feedback      AppFeedback[]
}

model Doctor {
  id            String    @id @default(cuid())
  fullName      String
  specialty     String
  age           Int
  photoUrl      String?
  bio           String?
  workDays      Weekday[]
  workStartTime String
  workEndTime   String
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  appointments Appointment[]
}

model Appointment {
  id          String            @id @default(cuid())
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id])
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  scheduledAt DateTime
  status      AppointmentStatus @default(BOOKED)
  note        String?
  createdAt   DateTime          @default(now())

  @@unique([doctorId, scheduledAt])
  @@index([customerId])
  @@index([doctorId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  label      String?
  fullAddress String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders Order[]
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

model Order {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  addressId      String?
  address        Address?      @relation(fields: [addressId], references: [id])
  deliveryMethod DeliveryMethod @default(DELIVERY)
  pickupBranchId String?
  pickupBranch   Branch?       @relation("OrderPickupBranch", fields: [pickupBranchId], references: [id])
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(12, 2)
  deliveryFee    Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  requiresPrescription Boolean @default(false)
  prescriptionImageUrl String?
  courierNote    String?
  discountCode   String?
  discountAmount Decimal       @db.Decimal(12, 2) @default(0)
  deliveryZoneName String?
  returnStatus   ReturnRequestStatus?
  returnReason   String?
  returnNote     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items OrderItem[]

  @@index([customerId])
  @@index([status])
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String
  fee       Decimal  @db.Decimal(12, 2)
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  products        Product[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  batches OrderItemBatch[]
}

model OrderItemBatch {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  batchId     String
  batch       Batch     @relation(fields: [batchId], references: [id])
  quantity    Int

  expiryNotifications ExpiryNotification[]

  @@index([orderItemId])
  @@index([batchId])
}

model ExpiryNotification {
  id               String         @id @default(cuid())
  orderItemBatchId String
  orderItemBatch   OrderItemBatch @relation(fields: [orderItemBatchId], references: [id])
  thresholdDays    Int
  createdAt        DateTime       @default(now())

  @@unique([orderItemBatchId, thresholdDays])
}

model Notification {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id])
  type       NotificationType
  title      String
  body       String
  productId  String?
  product    Product?         @relation(fields: [productId], references: [id])
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([customerId, isRead])
}

model StockAlertSubscription {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([productId, notifiedAt])
}

model Branch {
  id         String      @id @default(cuid())
  name       String
  region     String?
  address    String?
  phone      String?
  isActive   Boolean     @default(true)
  managerId  String?
  manager    User?       @relation("BranchManager", fields: [managerId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  warehouses Warehouse[]
  users      User[]
  pickupOrders Order[]   @relation("OrderPickupBranch")
  posSales     PosSale[]
}

model Warehouse {
  id       String @id @default(cuid())
  name     String
  location String?
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches           Batch[]
  movements         StockMovement[]
  transfersFrom     StockTransfer[]     @relation("TransferFrom")
  transfersTo       StockTransfer[]     @relation("TransferTo")
  inventoryCounts    InventoryCount[]
  purchaseOrders    PurchaseOrder[]
}

// ---------- Pharmacy lookups ----------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String    @unique
  country   String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model ActiveIngredient {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

// ---------- Pharmacy: Product ----------

model Product {
  id                   String       @id @default(cuid())
  name                 String
  barcode              String       @unique
  categoryId           String?
  category             Category?    @relation(fields: [categoryId], references: [id])
  brandId              String?
  brand                Brand?       @relation(fields: [brandId], references: [id])
  manufacturerId       String?
  manufacturer         Manufacturer? @relation(fields: [manufacturerId], references: [id])
  activeIngredientId   String?
  activeIngredient     ActiveIngredient? @relation(fields: [activeIngredientId], references: [id])
  dosage               String?
  unit                 String
  prescriptionRequired Boolean      @default(false)
  imageUrl             String?
  description          String?
  purchasePrice        Decimal      @db.Decimal(12, 2)
  sellPrice            Decimal      @db.Decimal(12, 2)
  oldPrice             Decimal?     @db.Decimal(12, 2)
  minStock             Int          @default(0)
  maxStock             Int          @default(0)
  stockMethod          StockMethod  @default(FEFO)
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  batches   Batch[]
  movements StockMovement[]
  transfers StockTransfer[]
  countItems InventoryCountItem[]
  orderItems OrderItem[]
  notifications Notification[]
  stockAlerts   StockAlertSubscription[]
  purchaseOrderItems PurchaseOrderItem[]
  promoCodes    PromoCode[]
  reviews       Review[]
  posSaleItems  PosSaleItem[]

  @@index([name])
}

enum PosPaymentMethod {
  CASH
  CARD
}

model PosSale {
  id             String           @id @default(cuid())
  cashierId      String
  cashier        User             @relation(fields: [cashierId], references: [id])
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id])
  subtotal       Decimal          @db.Decimal(12, 2)
  discountAmount Decimal          @db.Decimal(12, 2) @default(0)
  total          Decimal          @db.Decimal(12, 2)
  paymentMethod  PosPaymentMethod @default(CASH)
  createdAt      DateTime         @default(now())

  items PosSaleItem[]

  @@index([cashierId])
  @@index([createdAt])
}

model PosSaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      PosSale @relation(fields: [saleId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId])
}

model AppFeedback {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int?
  message    String
  createdAt  DateTime @default(now())
}

// ---------- Inventory ----------

model Batch {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  batchNumber   String
  expiryDate    DateTime
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  quantity      Int
  purchasePrice Decimal   @db.Decimal(12, 2)
  supplierName  String?
  receivedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movements    StockMovement[]
  transfers    StockTransfer[]
  countItems   InventoryCountItem[]
  orderItemBatches OrderItemBatch[]

  @@index([productId, warehouseId])
  @@index([expiryDate])
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  batchId       String?
  batch         Batch?       @relation(fields: [batchId], references: [id])
  warehouseId   String
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  type          MovementType
  quantity      Int
  reason        String?
  performedById String?
  performedBy   User?        @relation(fields: [performedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
}

model StockTransfer {
  id               String         @id @default(cuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch          @relation(fields: [batchId], references: [id])
  fromWarehouseId  String
  fromWarehouse    Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId    String
  toWarehouse      Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  quantity         Int
  status           TransferStatus @default(PENDING)
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  completedAt      DateTime?
}

model InventoryCount {
  id          String                @id @default(cuid())
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  status      InventoryCountStatus  @default(IN_PROGRESS)
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id])
  startedAt   DateTime              @default(now())
  completedAt DateTime?

  items InventoryCountItem[]
}

model InventoryCountItem {
  id               String         @id @default(cuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch          @relation(fields: [batchId], references: [id])
  systemQty        Int
  countedQty       Int?
  diff             Int?
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------- Supplier Management / Procurement ----------

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  createdById  String
  createdBy    User                @relation(fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  receivedAt   DateTime?

  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
}

// ---------- Finance / Accounting ----------

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  category    String
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  occurredAt  DateTime        @default(now())
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([occurredAt])
  @@index([type])
}

model Invoice {
  id          String        @id @default(cuid())
  type        InvoiceType
  partyName   String
  amount      Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime?
  issuedAt    DateTime      @default(now())
  paidAt      DateTime?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([status])
}

// ---------- HR / Payroll ----------

model Employee {
  id         String   @id @default(cuid())
  fullName   String
  position   String
  department String?
  phone      String?
  email      String?
  hireDate   DateTime
  salary     Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payslips Payslip[]
}

model Payslip {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id])
  month       String
  baseSalary  Decimal       @db.Decimal(12, 2)
  bonuses     Decimal       @db.Decimal(12, 2) @default(0)
  deductions  Decimal       @db.Decimal(12, 2) @default(0)
  netPay      Decimal       @db.Decimal(12, 2)
  status      PayslipStatus @default(DRAFT)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@unique([employeeId, month])
}

// ---------- CRM ----------

model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  note        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([customerId])
}

// ---------- Staff Notifications ----------

model StaffNotification {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  type      StaffNotificationType
  title     String
  body      String
  isRead    Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@index([userId, isRead])
}

// ---------- RBAC (new modules only) ----------

model RolePermission {
  id      String  @id @default(cuid())
  role    Role
  module  String
  action  String
  allowed Boolean @default(false)

  @@unique([role, module, action])
}

// ---------- Settings ----------

model AppSetting {
  id            String   @id @default("singleton")
  companyName   String   @default("PharmCare")
  supportPhone  String?
  supportEmail  String?
  currencySymbol String  @default("so'm")
  updatedAt     DateTime @updatedAt
}
