generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  PHARMACIST
  CASHIER
  WAREHOUSE_MANAGER
  HR
  ACCOUNTANT
  MANAGER
}

enum StockMethod {
  FEFO
  FIFO
}

enum MovementType {
  IN
  OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum InventoryCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------- Core / Org ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements  StockMovement[]
  stockTransfers  StockTransfer[]
  inventoryCounts InventoryCount[]
  auditLogs       AuditLog[]
}

model Branch {
  id         String      @id @default(cuid())
  name       String
  address    String?
  phone      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  warehouses Warehouse[]
  users      User[]
}

model Warehouse {
  id       String @id @default(cuid())
  name     String
  location String?
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches           Batch[]
  movements         StockMovement[]
  transfersFrom     StockTransfer[]     @relation("TransferFrom")
  transfersTo       StockTransfer[]     @relation("TransferTo")
  inventoryCounts    InventoryCount[]
}

// ---------- Pharmacy lookups ----------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String    @unique
  country   String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model ActiveIngredient {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

// ---------- Pharmacy: Product ----------

model Product {
  id                   String       @id @default(cuid())
  name                 String
  barcode              String       @unique
  categoryId           String?
  category             Category?    @relation(fields: [categoryId], references: [id])
  brandId              String?
  brand                Brand?       @relation(fields: [brandId], references: [id])
  manufacturerId       String?
  manufacturer         Manufacturer? @relation(fields: [manufacturerId], references: [id])
  activeIngredientId   String?
  activeIngredient     ActiveIngredient? @relation(fields: [activeIngredientId], references: [id])
  dosage               String?
  unit                 String
  prescriptionRequired Boolean      @default(false)
  imageUrl             String?
  description          String?
  purchasePrice        Decimal      @db.Decimal(12, 2)
  sellPrice            Decimal      @db.Decimal(12, 2)
  minStock             Int          @default(0)
  maxStock             Int          @default(0)
  stockMethod          StockMethod  @default(FEFO)
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  batches   Batch[]
  movements StockMovement[]
  transfers StockTransfer[]
  countItems InventoryCountItem[]

  @@index([name])
}

// ---------- Inventory ----------

model Batch {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  batchNumber   String
  expiryDate    DateTime
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  quantity      Int
  purchasePrice Decimal   @db.Decimal(12, 2)
  supplierName  String?
  receivedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movements    StockMovement[]
  transfers    StockTransfer[]
  countItems   InventoryCountItem[]

  @@index([productId, warehouseId])
  @@index([expiryDate])
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  batchId       String?
  batch         Batch?       @relation(fields: [batchId], references: [id])
  warehouseId   String
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  type          MovementType
  quantity      Int
  reason        String?
  performedById String
  performedBy   User         @relation(fields: [performedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
}

model StockTransfer {
  id               String         @id @default(cuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch          @relation(fields: [batchId], references: [id])
  fromWarehouseId  String
  fromWarehouse    Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId    String
  toWarehouse      Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  quantity         Int
  status           TransferStatus @default(PENDING)
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  completedAt      DateTime?
}

model InventoryCount {
  id          String                @id @default(cuid())
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  status      InventoryCountStatus  @default(IN_PROGRESS)
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id])
  startedAt   DateTime              @default(now())
  completedAt DateTime?

  items InventoryCountItem[]
}

model InventoryCountItem {
  id               String         @id @default(cuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch          @relation(fields: [batchId], references: [id])
  systemQty        Int
  countedQty       Int?
  diff             Int?
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
