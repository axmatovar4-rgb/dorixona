generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  SUPER_ADMIN
  ADMIN
  PHARMACIST
  CASHIER
  WAREHOUSE_MANAGER
  HR
  ACCOUNTANT
  MANAGER
}

enum StockMethod {
  FEFO
  FIFO
}

enum MovementType {
  IN
  OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum InventoryCountStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PREPARING
  DELIVERING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CLICK
  PAYME
  UZCARD
  HUMO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum NotificationType {
  EXPIRY_WARNING
  BACK_IN_STOCK
}

// ---------- Core / Org ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements  StockMovement[]
  stockTransfers  StockTransfer[]
  inventoryCounts InventoryCount[]
  auditLogs       AuditLog[]
}

model Customer {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  phone             String   @unique
  address           String?
  passwordHash      String
  isActive          Boolean  @default(true)
  telegramChatId    String?  @unique
  telegramLinkToken String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  notifications Notification[]
  stockAlerts   StockAlertSubscription[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  label      String?
  fullAddress String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orders Order[]
}

model Order {
  id             String        @id @default(cuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  addressId      String
  address        Address       @relation(fields: [addressId], references: [id])
  status         OrderStatus   @default(PENDING)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(12, 2)
  deliveryFee    Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  requiresPrescription Boolean @default(false)
  prescriptionImageUrl String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items OrderItem[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  batches OrderItemBatch[]
}

model OrderItemBatch {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  batchId     String
  batch       Batch     @relation(fields: [batchId], references: [id])
  quantity    Int

  expiryNotifications ExpiryNotification[]

  @@index([orderItemId])
  @@index([batchId])
}

model ExpiryNotification {
  id               String         @id @default(cuid())
  orderItemBatchId String
  orderItemBatch   OrderItemBatch @relation(fields: [orderItemBatchId], references: [id])
  thresholdDays    Int
  createdAt        DateTime       @default(now())

  @@unique([orderItemBatchId, thresholdDays])
}

model Notification {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id])
  type       NotificationType
  title      String
  body       String
  productId  String?
  product    Product?         @relation(fields: [productId], references: [id])
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([customerId, isRead])
}

model StockAlertSubscription {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([productId, notifiedAt])
}

model Branch {
  id         String      @id @default(cuid())
  name       String
  address    String?
  phone      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  warehouses Warehouse[]
  users      User[]
}

model Warehouse {
  id       String @id @default(cuid())
  name     String
  location String?
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches           Batch[]
  movements         StockMovement[]
  transfersFrom     StockTransfer[]     @relation("TransferFrom")
  transfersTo       StockTransfer[]     @relation("TransferTo")
  inventoryCounts    InventoryCount[]
}

// ---------- Pharmacy lookups ----------

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String    @unique
  country   String?
  createdAt DateTime  @default(now())
  products  Product[]
}

model ActiveIngredient {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

// ---------- Pharmacy: Product ----------

model Product {
  id                   String       @id @default(cuid())
  name                 String
  barcode              String       @unique
  categoryId           String?
  category             Category?    @relation(fields: [categoryId], references: [id])
  brandId              String?
  brand                Brand?       @relation(fields: [brandId], references: [id])
  manufacturerId       String?
  manufacturer         Manufacturer? @relation(fields: [manufacturerId], references: [id])
  activeIngredientId   String?
  activeIngredient     ActiveIngredient? @relation(fields: [activeIngredientId], references: [id])
  dosage               String?
  unit                 String
  prescriptionRequired Boolean      @default(false)
  imageUrl             String?
  description          String?
  purchasePrice        Decimal      @db.Decimal(12, 2)
  sellPrice            Decimal      @db.Decimal(12, 2)
  minStock             Int          @default(0)
  maxStock             Int          @default(0)
  stockMethod          StockMethod  @default(FEFO)
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  batches   Batch[]
  movements StockMovement[]
  transfers StockTransfer[]
  countItems InventoryCountItem[]
  orderItems OrderItem[]
  notifications Notification[]
  stockAlerts   StockAlertSubscription[]

  @@index([name])
}

// ---------- Inventory ----------

model Batch {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  batchNumber   String
  expiryDate    DateTime
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  quantity      Int
  purchasePrice Decimal   @db.Decimal(12, 2)
  supplierName  String?
  receivedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  movements    StockMovement[]
  transfers    StockTransfer[]
  countItems   InventoryCountItem[]
  orderItemBatches OrderItemBatch[]

  @@index([productId, warehouseId])
  @@index([expiryDate])
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  batchId       String?
  batch         Batch?       @relation(fields: [batchId], references: [id])
  warehouseId   String
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  type          MovementType
  quantity      Int
  reason        String?
  performedById String?
  performedBy   User?        @relation(fields: [performedById], references: [id])
  createdAt     DateTime     @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
}

model StockTransfer {
  id               String         @id @default(cuid())
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch          @relation(fields: [batchId], references: [id])
  fromWarehouseId  String
  fromWarehouse    Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId    String
  toWarehouse      Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  quantity         Int
  status           TransferStatus @default(PENDING)
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  completedAt      DateTime?
}

model InventoryCount {
  id          String                @id @default(cuid())
  warehouseId String
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  status      InventoryCountStatus  @default(IN_PROGRESS)
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id])
  startedAt   DateTime              @default(now())
  completedAt DateTime?

  items InventoryCountItem[]
}

model InventoryCountItem {
  id               String         @id @default(cuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch          @relation(fields: [batchId], references: [id])
  systemQty        Int
  countedQty       Int?
  diff             Int?
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
